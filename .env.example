# Copy to .env (never commit). On EC2 these live in /opt/argus/argus.env
ARGUS_DATA_DIR=../center_data
ARGUS_CACHE_DIR=./cache
ARGUS_DB_PATH=./argus.db
ARGUS_LLM_PROVIDER=bedrock
ARGUS_LLM_MODEL=au.anthropic.claude-sonnet-4-6
ARGUS_LLM_FAST_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=ap-southeast-2
# Optional shared access code for the hosted demo
ARGUS_ACCESS_CODE=